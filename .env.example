# Copy to .env and fill in. .env is gitignored and must stay that way.

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# Project Settings -> Data API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Project Settings -> API Keys.
#
# Supabase renamed these in 2025. Either generation works; the variable
# names here are kept for compatibility:
#
#   SUPABASE_ANON_KEY          "publishable key"  sb_publishable_...
#                              Safe in a browser. Read-only to anyone not
#                              signed in, because RLS says so. This is the
#                              key written into the admin page at build time.
#
#   SUPABASE_SERVICE_ROLE_KEY  "secret key"       sb_secret_...
#                              Bypasses RLS completely. SERVER ONLY — never
#                              in the browser, never in the repo, never in
#                              a chat window. Needed by the importer, the
#                              backup script and CI.
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------
# Where the 400/800/1600 WebP derivatives are served from. Supabase
# Storage to begin with; point this at a CDN or Cloudflare R2 later and
# nothing else changes, because the database stores keys, not URLs.
IMAGE_BASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co/storage/v1/object/public/product-images
IMAGE_BUCKET=product-images

# Editorial photograph behind the home page showcase band. Site
# furniture rather than catalogue data, so it is named here rather
# than borrowing a division hero image.
SHOWCASE_IMAGE_KEY=site/showcase-counter

# ---------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------
# Used for canonical URLs, the sitemap and Open Graph tags. Must be the
# real public address or search engines will index the wrong one.
SITE_ORIGIN=https://www.bestech.lk
