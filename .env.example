# Supabase — the catalogue's source of truth
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
# Server-side only. Used by the importer and the static build.
# NEVER ships in the site bundle.
SUPABASE_SERVICE_ROLE_KEY=

# CDN hostname in front of the image bucket (Cloudflare R2 or Vercel Blob).
# The database stores storage keys, so changing provider is this one line.
IMAGE_BASE_URL=https://images.bestech.lk
