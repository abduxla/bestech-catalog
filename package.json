{
  "name": "bestech-catalog",
  "version": "1.0.0",
  "private": true,
  "description": "Bestech (Pvt) Ltd product catalogue — Postgres source of truth, pre-rendered to static HTML.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:cache": "node scripts/build.mjs --from-cache",
    "build:drafts": "node scripts/build.mjs --drafts",
    "doctor": "node scripts/doctor.mjs",
    "bundle": "node scripts/bundle-migrations.mjs",
    "fixture": "node scripts/dev-fixture.mjs",
    "dev": "node scripts/dev-fixture.mjs && node scripts/build.mjs --from-cache && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "import": "node import/import.mjs",
    "backup": "node scripts/backup.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {},
  "devDependencies": {}
}
